# 🤖 TELEGRAM CONFIGURATION

# Your main bot token from @BotFather
BOT_TOKEN=1234567890:AAH_xxx_YOUR_MAIN_BOT_TOKEN_xxx

# Token for the silent logging bot (Optional but recommended)
LOG_BOT_TOKEN=0987654321:AAH_xxx_YOUR_LOG_BOT_TOKEN_xxx

# Your personal Telegram User ID (Get from @userinfobot)
LOG_CHAT_ID=123456789
ALLOWED_USERS=123456789,987654321


# 📱 ADB CONFIGURATION

# The Wireless debugging IP and Port used in 'adb connect'
ADB_ADDRESS=192.168.x.x:PORT


# 🧠 LLM API KEYS (Comma separated for failover)

# Get from: https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1,gsk_key2

# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEYS=cer_key1,cer_key2

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEYS=sk-or-v1-key1